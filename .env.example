# The Agency - Development Environment Variables
# Copy to .env and fill in values.
# For production, use .env.production.example as base.

# Database
DATABASE_URL=postgresql+asyncpg://agency:agency@localhost:5432/the_agency

# Security
SECRET_KEY=generate-a-strong-random-key-here
ACCESS_TOKEN_EXPIRE_MINUTES=480
ALGORITHM=HS256

# Cookies (dev defaults)
AUTH_COOKIE_NAME=agency_access_token
CSRF_COOKIE_NAME=agency_csrf_token
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_PATH=/

# CORS
CORS_ORIGINS=http://localhost:5177

# Optional integrations
REDIS_URL=
DISCORD_WEBHOOK_URL=
ANTHROPIC_API_KEY=

# Holded ERP API key (optional — enables finance sync)
HOLDED_API_KEY=

# Engine (= Anvil): sólo el enlace "Abrir en Engine" de cada cliente, sin datos
ENGINE_FRONTEND_URL=https://engine.magnifytools.com
# Semáforo SEO: incidencia si los clics de 30 días caen este % con este mínimo previo
SEO_DROP_ALERT_PCT=20
SEO_DROP_MIN_CLICKS=100

# Defaults
DEFAULT_HOURLY_RATE=40.0
AGENCY_TIMEZONE=Europe/Madrid

# Railway sets PORT automatically
PORT=8004
