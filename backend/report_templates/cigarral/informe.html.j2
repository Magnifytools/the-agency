<!DOCTYPE html><html lang="es"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="color-scheme" content="light"><title>Seguimiento del restaurante · {{ mes_datos }} · {{ cliente.nombre }}</title><style>{{ css|safe }}</style></head><body>
<div class="progress" id="progress"></div><div class="cursor-ring" id="cursor-ring"></div><div class="cursor-dot" id="cursor-dot"></div>
<div class="shell"><aside class="side" id="sidebar"><a class="brand" href="{{ cliente.web }}" target="_blank" rel="noopener" aria-label="Sitio del Cigarral de Caravantes"><img src="{{ logo }}" alt="Cigarral de Caravantes"></a><div class="sidebar-client-name">{{ cliente.nombre }}</div><nav class="nav" id="nav" aria-label="Índice del informe"><a href="#resumen"><span class="num">01</span>Resumen estratégico</a><a href="#web"><span class="num">02</span>Visibilidad de la web</a><a href="#paginas"><span class="num">03</span>Páginas más visitadas</a><a href="#busquedas"><span class="num">04</span>Marca y búsquedas genéricas</a><a href="#analytics"><span class="num">05</span>Tráfico de la web</a><a href="#grupos"><span class="num">06</span>Grupos y celebraciones</a><a href="#mapas"><span class="num">07</span>Ficha de Google</a><a href="#reservas"><span class="num">08</span>Interés por grupos</a><a href="#tecnica"><span class="num">09</span>Mejoras de la web</a><a href="#roadmap"><span class="num">10</span>Plan de trabajo</a><a href="#fuentes"><span class="num">11</span>Sobre los datos</a></nav>
<div class="sidefoot"><button class="button" type="button" id="download-pdf">Descargar PDF</button><a class="button primary" href="#roadmap">Consultar el plan</a></div></aside>
<main class="main"><button type="button" aria-label="Abrir el índice" aria-controls="sidebar" id="mobile-menu" class="mobile-toggle">☰</button>
<header class="hero"><div class="inner"><img class="print-logo" src="{{ logo }}" alt="Logo oficial de Cigarral de Caravantes"><div class="mini-label">SEGUIMIENTO SEO LOCAL · {{ cliente.ciudad|upper }}</div><h1>La evolución del<br><em>restaurante Cigarral de Caravantes.</em></h1><p class="sub">Qué está pasando en Google, cómo nos encuentran los nuevos clientes y qué estamos haciendo para impulsar las visitas y las solicitudes de grupos.</p><div class="hero-stats"><span>Datos web: {{ mes_datos }}</span><span>Foco: restaurante, grupos y celebraciones</span><span>Informe elaborado: {{ info.fecha_documento }}</span></div><div class="demo-flag">{{ info.modo }}</div></div></header>
<div class="content">
<section id="resumen" class="section"><div class="section-head"><div class="section-heading"><div class="mini-label">01 / Visión general</div><h2>Resumen estratégico</h2><p class="summary">Los datos que mejor resumen cómo se está descubriendo el restaurante.</p></div></div>
<p class="executive-intro">El objetivo no es únicamente atraer más visitas, sino conseguir que también encuentren el restaurante quienes todavía no conocen Cigarral de Caravantes, especialmente cuando buscan dónde comer, reunirse o celebrar un evento en Toledo. Por eso seguimos tanto la visibilidad en Google como las visitas y las señales de interés que genera la ficha del restaurante.</p>
<div class="executive-wrap" aria-label="Indicadores principales del restaurante">
{% for group in kpi_groups %}
  <div class="executive-group">
    <div class="executive-group-heading">{{ group.titulo }}</div>
    <div class="executive-grid">
    {% for metric in group.metricas %}
      <div class="kpi executive-kpi">
        <div class="label">{{ metric.nombre }}</div>
        <div class="executive-value-row">{{ metric.icon_svg|safe }}<div class="value">{{ metric.valor }}</div></div>
        <div class="exec-detail">{{ metric.detalle }}</div>
        <div class="foot">{{ metric.pie }}</div>
      </div>
    {% endfor %}
    </div>
  </div>
{% endfor %}
</div>
<p class="executive-source">Datos web: {{ mes_datos }}. Datos de la ficha: {{ google.periodo }}. {{ t.resumen_fuente_cola }}</p>
<div class="client-read"><div class="read-head">Qué significa para el restaurante</div><p>{{ editorial.resumen }}</p></div><p class="notice"><strong>{{ t.aviso_etiqueta }}</strong> {{ info.nota }}</p></section>
<section id="web" class="section"><div class="section-head"><div class="section-heading"><div class="mini-label">02 / Rendimiento en Google</div><h2>Visibilidad de la web</h2><p class="summary">Seguimos tanto las visitas que conseguimos como las veces que Google muestra nuestra página. Son dos señales distintas y complementarias.</p></div></div>
<div class="metric-pair"><div class="kpi"><div class="label">Clics a /restaurante/</div><div class="value">{{ gsc.clics_mes|num }}</div><div class="foot">{{ yoy|pct }} {{ t.web_clics_pie }}</div></div><div class="kpi"><div class="label">Impresiones de /restaurante/</div><div class="value">{{ gsc.impresiones_mes|num }}</div><div class="foot">{{ impressions_yoy|pct }} {{ t.web_impresiones_pie }}</div></div></div>
<div class="chart-grid"><div class="chartpanel"><div class="chart-title"><h3>Evolución de los clics</h3><span>{{ t.clics_grafico_nota }}</span></div><div class="month-chart" id="month-chart" data-points='{{ chartdata|tojson }}'>{{ chartsvg|safe }}<div class="hoverpane" id="chart-tooltip"></div></div></div>
<div class="chartpanel"><div class="chart-title"><h3>Evolución de las impresiones</h3><span>{{ t.impresiones_grafico_nota }}</span></div><div class="month-chart" id="impression-chart" data-points='{{ impressionchartdata|tojson }}'>{{ impressionchartsvg|safe }}<div class="hoverpane" id="impression-tooltip"></div></div></div></div>
<p class="fine">{{ t.web_nota }}</p>
<div class="client-read"><div class="read-head">Lectura estratégica</div><p>{{ editorial.web }}</p></div></section>
<section id="paginas" class="section"><div class="section-head"><div class="section-heading"><div class="mini-label">03 / Páginas de la web</div><h2>Páginas más visitadas</h2><p class="summary">Las páginas de toda la web que más visitas reciben desde Google, y cómo evolucionan frente al mes anterior y al mismo mes del año pasado.</p></div></div>
<div class="tablewrap"><table class="table pages-table"><thead><tr><th>Página</th><th class="numcol">{{ lbl_actual }}</th><th class="numcol">{{ lbl_anterior }}</th><th class="numcol">Vs. mes anterior</th><th class="numcol">{{ lbl_interanual }}</th><th class="numcol">Vs. año anterior</th></tr></thead><tbody>{% for p in paginas %}<tr><td class="keycol">{{ p.nombre }}<div class="muted">{{ p.ruta }}</div></td><td class="numcol">{{ p.clics|blank }}</td><td class="numcol">{{ p.clics_anterior|blank }}</td><td class="numcol"><strong>{{ p.var_mes_txt or (p.var_mes|pctblank) }}</strong></td><td class="numcol">{{ p.clics_ano_anterior|blank }}</td><td class="numcol"><strong>{{ p.var_ano_txt or (p.var_ano|pctblank) }}</strong></td></tr>{% else %}<tr><td colspan="6" class="muted">Sin datos de páginas para este periodo.</td></tr>{% endfor %}</tbody></table></div>
<p class="fine">{{ t.paginas_nota }}</p>{% if editorial.paginas %}
<div class="client-read"><div class="read-head">Lectura estratégica</div><p>{{ editorial.paginas }}</p></div>{% endif %}</section>
<section id="busquedas" class="section"><div class="section-head"><div class="section-heading"><div class="mini-label">04 / Cómo nos encuentran</div><h2>Marca y búsquedas genéricas</h2><p class="summary">¿Llegan porque conocen Cigarral de Caravantes o porque buscan un restaurante en Toledo? Separarlo permite medir la captación de clientes nuevos.</p></div></div>
<div class="chart-grid brand-layout"><div class="panel"><h3 class="block-title">Reparto de clics de {{ lbl_actual|lower }}</h3><div class="pie-flex"><div class="donut" role="img" aria-label="{{ brand_click_pct|share }} de clics de marca y {{ generic_click_pct|share }} de clics genéricos en el ejemplo" style="--a:{{ brand_click_pct }}%;"><div class="donut-hole"><strong>{{ gsc.clics_mes|num }}</strong><small>clics</small></div></div><div class="pie-legend"><div><i class="swatch mark"></i><strong>Marca</strong><span>{{ intent.marca.clics|num }} clics · {{ brand_click_pct|share }}</span></div><div><i class="swatch generic"></i><strong>Genéricas</strong><span>{{ intent.generica.clics|num }} clics · {{ generic_click_pct|share }}</span></div></div></div><p class="fine">{{ t.reparto_nota }}</p></div>
<div class="panel"><h3 class="block-title">Cómo cambia cada grupo</h3><table class="table intent-table"><thead><tr><th>Tipo de búsqueda</th><th class="numcol">{{ lbl_anterior }}</th><th class="numcol">{{ lbl_actual }}</th><th class="numcol">Variación</th></tr></thead><tbody>{% for item in intent.rows %}<tr><td><strong>{{ item.tipo }}</strong><div class="muted">{{ item.descripcion }}</div></td><td class="numcol">{{ item.prev_clics|num }}</td><td class="numcol">{{ item.clics|num }}</td><td class="numcol"><strong>{{ item.change|pct }}</strong></td></tr>{% endfor %}</tbody></table><p class="fine">{{ t.intencion_nota }}</p></div></div>
<div class="client-read"><div class="read-head">Lectura estratégica</div><p>{{ editorial.intencion }}</p></div></section>
<section id="analytics" class="section"><div class="section-head"><div class="section-heading"><div class="mini-label">05 / Visitas a la web</div><h2>Tráfico de la web</h2><p class="summary">Cómo llegan las visitas a toda la web según Google Analytics, por canal: buscadores, visitas directas, otras webs y redes sociales.</p></div></div>
{% if not ga4.disponible %}<p class="notice" style="margin:0 0 15px"><strong>{{ t.ga_pendiente_etiqueta }}</strong> {{ t.ga_nota }}</p>{% endif %}
<div style="display:grid;gap:17px"><div class="panel"><h3 class="block-title">Adquisición de tráfico</h3><div class="tablewrap"><table class="table ga-table"><thead><tr><th>Canal</th><th class="numcol">Sesiones</th><th class="numcol">Vs. mes anterior</th><th class="numcol">Vs. año anterior</th><th class="numcol">Sesiones con interacción</th><th class="numcol">Eventos clave</th></tr></thead><tbody>{% for r in ga4.trafico %}<tr><td class="keycol">{{ r.canal }}</td><td class="numcol">{{ r.sesiones|blank }}</td><td class="numcol"><strong>{{ r.var_mes|pctblank }}</strong></td><td class="numcol"><strong>{{ r.var_ano|pctblank }}</strong></td><td class="numcol">{{ r.sesiones_interaccion|blank }}</td><td class="numcol">{{ r.eventos_clave|blank }}</td></tr>{% endfor %}</tbody></table></div><p class="fine">Sesiones: visitas a la web, agrupadas por el canal de cada visita. {{ t.ga_periodos }}</p></div>
<div class="panel"><h3 class="block-title">Adquisición de usuarios</h3><div class="tablewrap"><table class="table ga-table"><thead><tr><th>Canal</th><th class="numcol">Usuarios nuevos</th><th class="numcol">Vs. mes anterior</th><th class="numcol">Vs. año anterior</th><th class="numcol">Usuarios totales</th></tr></thead><tbody>{% for r in ga4.usuarios %}<tr><td class="keycol">{{ r.canal }}</td><td class="numcol">{{ r.usuarios_nuevos|blank }}</td><td class="numcol"><strong>{{ r.var_mes|pctblank }}</strong></td><td class="numcol"><strong>{{ r.var_ano|pctblank }}</strong></td><td class="numcol">{{ r.usuarios_totales|blank }}</td></tr>{% endfor %}</tbody></table></div><p class="fine">Usuarios nuevos: personas que visitan la web por primera vez, agrupadas por el canal por el que llegaron. {{ t.ga_periodos }}</p></div></div>
{% if editorial.analytics %}<div class="client-read"><div class="read-head">Lectura estratégica</div><p>{{ editorial.analytics }}</p></div>{% endif %}</section>
<section id="grupos" class="section"><div class="section-head"><div class="section-heading"><div class="mini-label">06 / Demanda comercial</div><h2>Grupos y celebraciones</h2><p class="summary">Vigilamos consultas que expresan interés por reuniones, comidas de empresa, celebraciones y restaurantes con vistas.</p></div></div>
<div class="tablewrap"><table class="table groups-table"><thead><tr><th>Búsqueda en Google</th><th class="numcol">{{ lbl_anterior }} · impresiones</th><th class="numcol">{{ lbl_actual }} · impresiones</th><th class="numcol">Evolución</th><th class="numcol">Clics en {{ lbl_actual|lower }}</th></tr></thead><tbody>{% for q in grupos.consultas %}<tr><td class="keycol">{{ q.q }}<div class="muted">{{ q.intencion }}</div></td><td class="numcol">{{ q.ago_imp|num }}</td><td class="numcol">{{ q.sep_imp|num }}</td><td class="numcol"><strong>{{ q.evol_txt or (q.evol|pct) }}</strong></td><td class="numcol">{{ q.sep_clics|num }}</td></tr>{% endfor %}</tbody></table></div>
<p class="fine"><strong>{{ t.grupos_nota_etiqueta }}</strong> {{ t.grupos_nota }}</p>
<div class="client-read"><div class="read-head">Lectura estratégica y estacionalidad</div><p>{{ editorial.grupos }}</p></div></section>
<section id="mapas" class="section"><div class="section-head"><div class="section-heading"><div class="mini-label">07 / Búsquedas locales</div><h2>Ficha de Google</h2><p class="summary">La ficha independiente del restaurante permite encontrarlo, llamar, consultar la carta y pedir indicaciones. {{ t.ficha_resumen_cola }}</p></div></div>
<div class="cards3 local-kpis">
  <div class="kpi"><div class="label">Personas que vieron la ficha</div>
    <div class="metric-row"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12z"/><circle cx="12" cy="12" r="3"/></svg><div class="value">{{ google.vistas_perfil|num }}</div></div>
    <div class="foot">{{ t.ficha_vistas_pie }}</div></div>
  <div class="kpi"><div class="label">Solicitudes de cómo llegar</div>
    <div class="metric-row"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 10c0 5.3-8 11-8 11S4 15.3 4 10a8 8 0 0 1 16 0z"/><circle cx="12" cy="10" r="2.7"/></svg><div class="value">{{ google.indicaciones|num }}</div></div>
    <div class="foot">Pulsaciones para consultar la ruta</div></div>
  <div class="kpi"><div class="label">Clics a la web desde la ficha</div>
    <div class="metric-row"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M3.2 12h17.6M12 3c-3 3.5-3.7 6.5-3.7 9s.7 5.5 3.7 9M12 3c3 3.5 3.7 6.5 3.7 9s-.7 5.5-3.7 9"/></svg><div class="value">{{ google.clics_web|num }}</div></div>
    <div class="foot">No equivalen a visitas orgánicas de la web</div></div>
</div>
<div class="twocol" style="margin-top:16px"><div class="panel"><h3 class="block-title">Otras acciones de contacto</h3><div class="tiny-grid">
<div class="tiny-stat"><div class="tiny-top"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2A19.7 19.7 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7l.5 3a2 2 0 0 1-.6 1.7L7.5 9.9a16 16 0 0 0 6.6 6.6l1.5-1.5a2 2 0 0 1 1.7-.6l3 .5a2 2 0 0 1 1.7 2z"/></svg><div class="v">{{ google.clics_llamada|num }}</div></div><div class="l">Pulsaciones para llamar</div></div>
<div class="tiny-stat"><div class="tiny-top"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M16 3v4M8 3v4M3 10h18M8 15l3 3 5-5"/></svg><div class="v">{{ google.acciones_reserva|num }}</div></div><div class="l">Acciones de reserva indicadas</div></div>
<div class="tiny-stat"><div class="tiny-top"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5h16v14H4zM8 9h8M8 13h8M8 17h5"/></svg><div class="v">{{ google.clics_carta|num }}</div></div><div class="l">Consultas de la carta</div></div>
<div class="tiny-stat"><div class="tiny-top"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 12h4l3-7 4 14 3-7h4"/></svg><div class="v">{{ google.interacciones|num }}</div></div><div class="l">Interacciones con la ficha</div></div></div><p class="fine" style="margin-top:12px">{{ t.ficha_nota }}</p></div>
<div class="panel"><h3 class="block-title">Búsquedas que mostraron la ficha</h3><div class="tablewrap"><table class="table"><thead><tr><th>Consulta</th><th class="numcol">Apariciones</th></tr></thead><tbody>{% for q in google.consultas %}<tr><td>{{ q.q }}<div class="muted">{{ q.tipo }}</div></td><td class="numcol">{{ q.apariciones|num }}</td></tr>{% endfor %}</tbody></table></div></div></div>
<div class="client-read"><div class="read-head">Lectura estratégica</div><p>{{ editorial.maps }}</p></div></section>
<section id="reservas" class="section"><div class="section-head"><div class="section-heading"><div class="mini-label">08 / Interés comercial</div><h2>Interés por grupos</h2><p class="summary">Seguimos las búsquedas de eventos y celebraciones en Google y las acciones realizadas desde la ficha del restaurante, sin atribuirles reservas concretas.</p></div></div>
<div class="twocol"><div class="panel"><h3 class="block-title">Consultas sobre eventos y celebraciones</h3><div class="tablewrap"><table class="table" aria-label="Consultas de Search Console sobre eventos y celebraciones"><thead><tr><th>Consulta</th><th class="numcol">Impresiones</th><th class="numcol">Clics</th></tr></thead><tbody>{% for q in grupos.consultas[:2] %}<tr><td>{{ q.q }}</td><td class="numcol">{{ q.imp|num }}</td><td class="numcol">{{ q.clics|num }}</td></tr>{% endfor %}</tbody></table></div><p class="fine">{{ t.grupos_acumulado_nota }}</p></div>
<div class="panel"><h3 class="block-title">Visibilidad y acciones en la ficha de Google</h3><div class="signals-grid"><div class="signal"><div class="signal-value">{{ google.busquedas_que_mostraron_ficha|num }}</div><div class="signal-label">Búsquedas que mostraron la ficha</div></div><div class="signal"><div class="signal-value">{{ google.clics_llamada|num }}</div><div class="signal-label">Pulsaciones para llamar</div></div></div><p class="fine">{{ t.ficha_grupos_nota }}</p></div></div>
<div class="client-read"><div class="read-head">Lectura estratégica</div><p>{{ editorial.negocio }}</p></div></section>
<section id="tecnica" class="section"><div class="section-head"><div class="section-heading"><div class="mini-label">09 / Mejoras y seguimiento</div><h2>Mejoras de la web</h2><p class="summary">Un resumen de los puntos detectados, por qué importan y su situación. No daremos ningún problema por resuelto sin comprobarlo.</p></div></div>
<div class="tablewrap"><table class="table tech-table"><thead><tr><th>Qué hemos detectado</th><th>Por qué importa</th><th>Situación</th><th>Próximo paso</th></tr></thead><tbody>
{% if tecnico.filas_rastreo %}{% for x in tecnico.filas_rastreo %}<tr><td><strong>{{ x.titulo }}</strong></td><td>{{ x.detalle }}</td><td><span class="state-pill">{{ x.estado }}</span></td><td>{{ x.siguiente }}</td></tr>{% endfor %}{% else %}<tr><td><strong>{{ tecnico.enlaces_redirigen|num }} enlaces a páginas que redirigen</strong></td><td>La navegación pasa por pasos innecesarios. Son enlaces encontrados desde {{ tecnico.origenes|num }} páginas, no tantas páginas distintas.</td><td><span class="state-pill">Por comprobar</span></td><td>Revisar de nuevo tras los cambios y comparar con el rastreo inicial.</td></tr>
<tr><td><strong>{{ tecnico.recurrentes|num }} enlaces repetidos en navegación</strong></td><td>Se concentran en cabecera, menú móvil y pie de página.</td><td><span class="state-pill">Pendiente</span></td><td>Actualizar los componentes comunes si el editor lo permite.</td></tr>{% endif %}
{% for x in tecnico.otros %}<tr><td><strong>{{ x.titulo }}</strong></td><td>{{ x.detalle }}</td><td><span class="state-pill">{{ x.estado }}</span></td><td>{{ x.siguiente or 'Verificar la incidencia antes de intervenir.' }}</td></tr>{% endfor %}
</tbody></table></div><div class="client-read"><div class="read-head">Lectura estratégica</div><p>{{ editorial.tecnico }}</p></div></section>
<section id="roadmap" class="section"><div class="section-head"><div class="section-heading"><div class="mini-label">10 / Calendario de actuaciones</div><h2>Plan de trabajo</h2><p class="summary">Selecciona cualquier mes para conocer las actuaciones previstas. Cada una puede figurar como Realizada, En curso, En espera, Eliminada o Prevista.</p></div></div>
<div class="roadmap-box"><div class="month-switches" role="tablist" aria-label="Seleccionar mes del plan">{% for mon in months %}<button type="button" role="tab" class="roadmap-tab" id="tab-{{ mon }}" data-month="{{ mon }}" aria-controls="month-{{ mon }}" aria-selected="false" tabindex="-1">{{ mon|shortmonth }}<span class="year">{{ mon[:4] }}</span></button>{% endfor %}</div>
{% for mon in months %}<div class="month-panel" id="month-{{ mon }}" role="tabpanel" aria-labelledby="tab-{{ mon }}" data-month="{{ mon }}"><div class="month-meta"><div><div class="mini-label">{{ mon|monthlabel }}</div><h3>{{ roadmap.meses[mon].titulo_publico or roadmap.meses[mon].titulo }}</h3></div><div class="sub">{{ roadmap.meses[mon].tareas|length }} actuaciones</div></div>
{% for t in roadmap.meses[mon].tareas %}<div class="roadmap-task"><i class="statusdot {{ t.estado }}" aria-hidden="true"></i><div><div class="task-title">{{ t.nombre_publico or t.nombre }}</div><div class="task-desc">{{ t.detalle_publico or t.detalle }}</div>{% if t.motivo %}<div class="task-reason">{{ t.motivo }}</div>{% endif %}</div><div class="task-state {{ t.estado }}">{% if t.estado == 'hecho' %}✓ {% endif %}{{ t.estado|statuslabel }}</div></div>{% endfor %}{% if roadmap.meses[mon].comentario %}<div class="notice">{{ roadmap.meses[mon].comentario }}</div>{% endif %}</div>{% endfor %}
<div class="fine" style="margin-top:14px">{{ t.plan_nota }}</div></div></section>
<section id="fuentes" class="section"><div class="section-head"><div class="section-heading"><div class="mini-label">11 / Criterios de medición</div><h2>Sobre los datos</h2><p class="summary">{{ t.fuentes_resumen }}</p></div></div>
<div class="sourcebox"><p><strong>Search Console:</strong> {{ t.fuentes_gsc }}</p>
<p><strong>Páginas más visitadas:</strong> {{ t.fuentes_paginas }}</p>
<p><strong>Marca y búsquedas genéricas:</strong> {{ t.fuentes_marca }}</p>
<p><strong>Google Analytics:</strong> {{ t.fuentes_ga }}</p>
<p><strong>Grupos:</strong> {{ t.fuentes_grupos }}</p>
<p><strong>Ficha de Google:</strong> {{ t.fuentes_ficha }}</p>
<p><strong>Trabajo:</strong> {{ t.fuentes_trabajo }}</p></div></section>
<div class="footer"><span>{{ cliente.nombre }} · seguimiento de posicionamiento local</span><span>Preparado para el equipo del restaurante · {{ info.fecha_documento }}</span></div></div></main></div>
<script>
(function(){const side=document.getElementById('sidebar'),mobile=document.getElementById('mobile-menu'),links=[...document.querySelectorAll('#nav a')],prog=document.getElementById('progress');mobile?.addEventListener('click',()=>side.classList.toggle('open'));links.forEach(a=>a.addEventListener('click',()=>side.classList.remove('open')));const update=()=>{let max=document.documentElement.scrollHeight-innerHeight;prog.style.width=(max?100*scrollY/max:0)+'%';let active=links[0];for(const a of links){const el=document.querySelector(a.getAttribute('href'));if(el&&el.getBoundingClientRect().top<Math.min(220,innerHeight*.28))active=a}if(scrollY+innerHeight>=document.documentElement.scrollHeight-12)active=links[links.length-1];links.forEach(a=>{a.classList.toggle('active',a===active);if(a===active&&a.getAttribute('aria-current')!=='location'){a.setAttribute('aria-current','location')}else if(a!==active){a.removeAttribute('aria-current')}})};addEventListener('scroll',update,{passive:true});update();
const tabs=[...document.querySelectorAll('.roadmap-tab')],panels=[...document.querySelectorAll('.month-panel')];const pref={{ preferred_month|tojson }};const now=new Date(),liveMonth=now.getFullYear()+'-'+String(now.getMonth()+1).padStart(2,'0');const names=tabs.map(t=>t.dataset.month);const initial=(pref&&names.includes(pref)?pref:names.includes(liveMonth)?liveMonth:{{ fallback_month|tojson }});function choose(m,focus=false){tabs.forEach(t=>{const on=t.dataset.month===m;t.classList.toggle('active',on);t.setAttribute('aria-selected',String(on));t.tabIndex=on?0:-1;if(on&&focus)t.focus()});panels.forEach(p=>p.classList.toggle('active',p.dataset.month===m))}tabs.forEach((t,i)=>{t.addEventListener('click',()=>choose(t.dataset.month));t.addEventListener('keydown',e=>{if(['ArrowRight','ArrowLeft','Home','End'].includes(e.key)){e.preventDefault();let j=e.key==='Home'?0:e.key==='End'?tabs.length-1:(i+(e.key==='ArrowRight'?1:-1)+tabs.length)%tabs.length;choose(tabs[j].dataset.month,true)}})});choose(initial);
for(const [chartId,tipId] of [['month-chart','chart-tooltip'],['impression-chart','impression-tooltip']]){const shell=document.getElementById(chartId),tip=document.getElementById(tipId);if(!shell||!tip)continue;const list=JSON.parse(shell.dataset.points||'[]');for(const c of shell.querySelectorAll('circle.chartspot')){const p=list[Number(c.dataset.i)];const show=()=>{const outer=shell.getBoundingClientRect(),r=c.getBoundingClientRect();tip.innerHTML='<b>'+p.nombre+'</b>'+Number(p.valor).toLocaleString('es-ES')+' '+p.unidad;tip.style.display='block';tip.style.left=Math.min(Math.max(5,r.left-outer.left+10),Math.max(5,outer.width-tip.offsetWidth-5))+'px';tip.style.top=Math.max(0,r.top-outer.top-47)+'px'};c.addEventListener('mouseenter',show);c.addEventListener('mouseleave',()=>tip.style.display='none');c.addEventListener('focus',show);c.addEventListener('blur',()=>tip.style.display='none')}}
const button=document.getElementById('download-pdf');button?.addEventListener('click',()=>{const node=document.getElementById('embedded-pdf');if(!node?.textContent?.trim()){alert('El PDF incrustado no está disponible.');return;}try{const raw=node.textContent.replace(/\s/g,'');const pieces=[];for(let i=0;i<raw.length;i+=32768){const binary=atob(raw.slice(i,i+32768)),bytes=new Uint8Array(binary.length);for(let j=0;j<binary.length;j++)bytes[j]=binary.charCodeAt(j);pieces.push(bytes)}const url=URL.createObjectURL(new Blob(pieces,{type:'application/pdf'})),a=document.createElement('a');a.href=url;a.download={{ pdf_filename|tojson }};document.body.appendChild(a);a.click();a.remove();setTimeout(()=>URL.revokeObjectURL(url),15000)}catch(e){alert('No se ha podido descargar el PDF incrustado.')}});
if(matchMedia('(pointer:fine) and (prefers-reduced-motion:no-preference)').matches){
  const ring=document.getElementById('cursor-ring'),dot=document.getElementById('cursor-dot');
  document.body.classList.add('custom-cursor');
  let targetX=0,targetY=0,ringX=0,ringY=0,hasPosition=false,animation=null;
  const animateRing=()=>{
    // El punto sigue al cursor sin demora. El círculo llega suavemente detrás.
    ringX+=(targetX-ringX)*.17;
    ringY+=(targetY-ringY)*.17;
    ring.style.left=ringX+'px';ring.style.top=ringY+'px';
    if(Math.abs(targetX-ringX)>.2||Math.abs(targetY-ringY)>.2){animation=requestAnimationFrame(animateRing)}
    else{ring.style.left=targetX+'px';ring.style.top=targetY+'px';animation=null}
  };
  addEventListener('pointermove',e=>{
    targetX=e.clientX;targetY=e.clientY;
    dot.style.left=targetX+'px';dot.style.top=targetY+'px';
    if(!hasPosition){ringX=targetX;ringY=targetY;hasPosition=true;ring.style.left=ringX+'px';ring.style.top=ringY+'px'}
    ring.style.opacity=dot.style.opacity='1';
    ring.classList.toggle('oncontrol',!!e.target.closest('a,button'));
    if(animation===null)animation=requestAnimationFrame(animateRing);
  },{passive:true});
  addEventListener('pointerleave',()=>{
    ring.style.opacity=dot.style.opacity='0';hasPosition=false;
    if(animation!==null){cancelAnimationFrame(animation);animation=null}
  });
}
})();
</script><script type="application/pdf" id="embedded-pdf">{{ pdf_blob|safe }}</script></body></html>
